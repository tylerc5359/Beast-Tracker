{
  "name": "beast-media-tracker",
  "version": "26.11.0",
  "description": "Beast Media Tracker",
  "author": "tylerc5359",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "setup": "node node_modules/electron/install.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.beast.mediatracker",
    "productName": "Beast Media Tracker",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "disk-store.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "styles/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Beast-Media-Tracker-Setup-${version}.${ext}"
    },
    "mac": {
      "target": { "target": "dmg", "arch": ["universal"] },
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Beast-Media-Tracker-${version}-mac.${ext}"
    },
    "linux": { "target": "AppImage" }
  }
}
